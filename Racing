    else userTabs[i].classList.remove('active');
  }
  for (var j = 0; j < userPanels.length; j++) {
    if (userPanels[j].getAttribute('data-upanel') === name) userPanels[j].classList.add('active');
    else userPanels[j].classList.remove('active');
  }
  if (name === 'shop') fetchShop();
  if (name === 'stats') fetchStats();
  if (name === 'balance') { fetchTxHistory(); fetchFinancialSummary(); }
  if (name === 'notif') fetchNotifications();
}
for (var ti = 0; ti < userTabs.length; ti++) {
  userTabs[ti].addEventListener('click', function() { switchUserTab(this.getAttribute('data-utab')); });
}

// ============ النافذة ============
function openPopup() {
  if (gameActive && !isPaused) pauseGame();
  if (currentUser) { updateUserInfo(); fetchTxHistory(); fetchFinancialSummary(); }
  else {
    popupBox.classList.remove('logged-in');
    statusMessage.textContent = '';
    usernameInput.value = ''; passwordInput.value = '';
  }
  popupOverlay.classList.add('active');
}
function closePopup() {
  popupOverlay.classList.remove('active');
  if (isPaused && roundData.isJoined && roundData.secondsRemaining > 3) setTimeout(maybeStartGame, 300);
}
proBtn.onclick = function(e) { if (e) { e.preventDefault(); e.stopPropagation(); } openPopup(); };
proBtn.addEventListener('pointerdown', function(e) { e.preventDefault(); e.stopPropagation(); openPopup(); }, true);
proBtn.addEventListener('touchstart', function(e) { e.preventDefault(); e.stopPropagation(); openPopup(); }, { passive: false, capture: true });
popupClose.onclick = function(e) { if (e) e.stopPropagation(); closePopup(); };
popupClose.addEventListener('pointerdown', function(e) { e.stopPropagation(); closePopup(); }, true);
popupOverlay.addEventListener('click', function(e) { if (e.target === popupOverlay) closePopup(); });
loginBtn.addEventListener('click', function(e) {
  e.stopPropagation();
  var u = usernameInput.value.trim(), p = passwordInput.value.trim();
  if (!u || !p) { statusMessage.textContent = '❌'; return; }
  login(u, p);
});
registerBtn.addEventListener('click', function(e) {
  e.stopPropagation();
  var u = usernameInput.value.trim(), p = passwordInput.value.trim();
  if (!u || !p) { statusMessage.textContent = '❌'; return; }
  register(u, p);
});
logoutBtn.addEventListener('click', function(e) { e.stopPropagation(); logout(); });

// ============ الثيم ============
themeBtn.addEventListener('click', function(e) {
  e.stopPropagation();
  setTheme(currentTheme === 'night' ? 'day' : 'night');
});

// ============ قائمة البيئات ============
var ENV_LIST = [
  { id:'highway', icon:'🛣️', name:'طريق سريع' },
  { id:'desert', icon:'🏜️', name:'صحراء' },
  { id:'city', icon:'🏙️', name:'مدينة' },
  { id:'night', icon:'🌃', name:'ليل' },
  { id:'rain', icon:'🌧️', name:'مطر' },
  { id:'snow', icon:'❄️', name:'ثلج' }
];
var envMenuBtn = document.getElementById('envMenuBtn');
var envMenuOverlay = document.getElementById('envMenuOverlay');
var envMenuGrid = document.getElementById('envMenuGrid');
var envMenuClose = document.getElementById('envMenuClose');

function updateEnvMenuIcon() {
  if (!envMenuBtn) return;
  for (var i = 0; i < ENV_LIST.length; i++) {
    if (ENV_LIST[i].id === currentEnv) { envMenuBtn.textContent = ENV_LIST[i].icon; break; }
  }
}
function renderEnvMenu() {
  if (!envMenuGrid) return;
  var h = '';
  for (var i = 0; i < ENV_LIST.length; i++) {
    var env = ENV_LIST[i];
    var isActive = currentEnv === env.id;
    h += '<div class="env-option' + (isActive ? ' active' : '') + '" data-env="' + env.id + '">';
    h += '<span class="env-icon">' + env.icon + '</span>';
    h += '<span class="env-name">' + env.name + '</span>';
    h += '</div>';
  }
  envMenuGrid.innerHTML = h;
  envMenuGrid.querySelectorAll('[data-env]').forEach(function(el) {
    el.addEventListener('click', function() { selectEnvironment(this.getAttribute('data-env')); });
  });
}
function selectEnvironment(envId) {
  currentEnv = envId;
  setEnv(currentEnv);
  updateEnvMenuIcon();
  var options = envMenuGrid.querySelectorAll('.env-option');
  options.forEach(function(opt) {
    if (opt.getAttribute('data-env') === envId) opt.classList.add('active');
    else opt.classList.remove('active');
  });
  setTimeout(function() { envMenuOverlay.classList.remove('active'); }, 250);
}
if (envMenuBtn) {
  envMenuBtn.addEventListener('click', function(e) {
    e.stopPropagation();
    renderEnvMenu();
    envMenuOverlay.classList.add('active');
  });
}
if (envMenuClose) {
  envMenuClose.addEventListener('click', function(e) {
    e.stopPropagation();
    envMenuOverlay.classList.remove('active');
  });
}
if (envMenuOverlay) {
  envMenuOverlay.addEventListener('click', function(e) {
    if (e.target === envMenuOverlay) envMenuOverlay.classList.remove('active');
  });
}

// ============ الجلسة ============
function restoreSession() {
  var s = null;
  try { s = localStorage.getItem('gameUser'); } catch(e) {}
  if (s) {
    try {
      var d = JSON.parse(s);
      login(d.username, d.password);
      return true;
    } catch(e) { try { localStorage.removeItem('gameUser'); } catch(err) {} }
  }
  return false;
}

// ============ Service Worker ============
if ('serviceWorker' in navigator) {
  window.addEventListener('load', function() {
    var swCode = 'self.addEventListener("install",function(e){self.skipWaiting()});' +
      'self.addEventListener("activate",function(e){e.waitUntil(self.clients.claim())});' +
      'self.addEventListener("fetch",function(e){e.respondWith(caches.open("game-v1").then(function(c){return c.match(e.request).then(function(r){return r||fetch(e.request).then(function(res){if(e.request.method==="GET")c.put(e.request,res.clone());return res})})}))})';
    navigator.serviceWorker.register('data:text/javascript,' + encodeURIComponent(swCode)).catch(function() {});
  });
}

// ============ التشغيل ============
window.addEventListener('load', function() {
  resizeCanvas();
  setLang(currentLang);
  setTheme(currentTheme);
  updateEnvMenuIcon();
  if (!restoreSession()) resetGame();
  fetchMessages();
  fetchRoundStatus();
  if (chatTimer) clearInterval(chatTimer);
  chatTimer = setInterval(fetchMessages, 5000);
  if (roundTimer) clearInterval(roundTimer);
  roundTimer = setInterval(tickRound, 1000);
  if (txTimer) clearInterval(txTimer);
  txTimer = setInterval(function() { if (currentUser && popupOverlay.classList.contains('active')) { fetchTxHistory(); fetchFinancialSummary(); } }, 10000);
  if (notifTimer) clearInterval(notifTimer);
  notifTimer = setInterval(function() { if (currentUser) fetchNotifications(); }, 30000);
  if (friendsTimer) clearInterval(friendsTimer);
  friendsTimer = setInterval(function() { if (currentUser && leftPanelMode === 'friends') fetchFriends(); }, 15000);
});

setTimeout(resizeCanvas, 100);
setTimeout(resizeCanvas, 500);

document.addEventListener('pointerdown', function() {
  initAudio();
  if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume();
}, { once: true });

if (document.readyState === 'complete') {
  resizeCanvas();
  if (!restoreSession()) resetGame();
  fetchMessages();
  fetchRoundStatus();
}

gameLoop();
})();
</script>
