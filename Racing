var AudioCtx = window.AudioContext || window.webkitAudioContext;
var audioCtx = null, masterGain = null, engineSound = null;
var isAudioInitialized = false, musicMuted = false, engineCurrentFreq = 60, engineRunning = false;

function initAudio() {
  if (isAudioInitialized) return;
  try {
    audioCtx = new AudioCtx();
    masterGain = audioCtx.createGain();
    masterGain.gain.value = musicMuted ? 0 : 1;
    masterGain.connect(audioCtx.destination);
    isAudioInitialized = true;
  } catch(e) {}
}
function startEngine() {
  if (!audioCtx || engineRunning) return;
  try {
    var o1 = audioCtx.createOscillator(); o1.type='sawtooth'; o1.frequency.value=60;
    var o2 = audioCtx.createOscillator(); o2.type='square'; o2.frequency.value=30;
    var o3 = audioCtx.createOscillator(); o3.type='triangle'; o3.frequency.value=180;
    var g = audioCtx.createGain(); g.gain.value = 0.1;
    var f = audioCtx.createBiquadFilter(); f.type='lowpass'; f.frequency.value=800; f.Q.value=2;
    o1.connect(f); o2.connect(f); o3.connect(f); f.connect(g); g.connect(masterGain);
    o1.start(); o2.start(); o3.start();
    engineSound = { osc1:o1, osc2:o2, osc3:o3, gain:g, filter:f };
    engineRunning = true;
    updateEngineSound();
  } catch(e) {}
}
function stopEngine() {
  if (!engineSound) return;
  try { engineSound.osc1.stop(); engineSound.osc2.stop(); engineSound.osc3.stop(); } catch(e) {}
  engineRunning = false; engineSound = null;
}
function updateEngineSound() {
  if (!engineSound) return;
  var sf = (playerSpeed - 3) / 6, base = 60 + sf * 100;
  engineCurrentFreq += (base - engineCurrentFreq) * 0.1;
  try {
    engineSound.osc1.frequency.value = engineCurrentFreq;
    engineSound.osc2.frequency.value = engineCurrentFreq * 0.5;
    engineSound.osc3.frequency.value = engineCurrentFreq * 3;
    engineSound.gain.gain.value = musicMuted ? 0 : (0.08 + sf * 0.12);
    engineSound.filter.frequency.value = 600 + sf * 1200;
  } catch(e) {}
}
function toggleMusic() {
  initAudio();
  if (audioCtx.state === 'suspended') audioCtx.resume();
  musicMuted = !musicMuted;
  if (musicMuted) {
    if (masterGain) masterGain.gain.value = 0;
    musicBtn.textContent = '🔇'; musicBtn.classList.add('muted');
  } else {
    if (masterGain) masterGain.gain.value = 1;
    musicBtn.textContent = '🔊'; musicBtn.classList.remove('muted');
    if (gameActive && !engineRunning) startEngine();
  }
}
musicBtn.addEventListener('click', function(e) { e.stopPropagation(); toggleMusic(); });

function crashSound() {
  if (!audioCtx) return;
  try {
    var o = audioCtx.createOscillator(), g = audioCtx.createGain();
    o.type = 'sawtooth'; o.frequency.setValueAtTime(200, audioCtx.currentTime);
    o.frequency.exponentialRampToValueAtTime(50, audioCtx.currentTime + 0.3);
    g.gain.setValueAtTime(0.3, audioCtx.currentTime);
    g.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.35);
    o.connect(g); g.connect(masterGain);
    o.start(); o.stop(audioCtx.currentTime + 0.36);
  } catch(e) {}
}
function beep(f, d, v) {
  if (!audioCtx) return;
  try {
    var o = audioCtx.createOscillator(), g = audioCtx.createGain();
    o.type = 'sine'; o.frequency.value = f;
    g.gain.setValueAtTime(v || 0.15, audioCtx.currentTime);
    g.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + d);
    o.connect(g); g.connect(masterGain);
    o.start(); o.stop(audioCtx.currentTime + d + 0.01);
  } catch(e) {}
}

function addParticle(x, y, color, count) {
  count = count || 5;
  for (var i = 0; i < count; i++) {
    particles.push({
      x: x, y: y,
      vx: (Math.random() - 0.5) * 6,
      vy: (Math.random() - 0.5) * 6 - 2,
      life: 30 + Math.random() * 20,
      color: color,
      size: 2 + Math.random() * 3
    });
  }
}
function updateParticles() {
  for (var i = particles.length - 1; i >= 0; i--) {
    var p = particles[i];
    p.x += p.vx; p.y += p.vy;
    p.vy += 0.2;
    p.life--;
    if (p.life <= 0) particles.splice(i, 1);
  }
}
function drawParticles() {
  for (var i = 0; i < particles.length; i++) {
    var p = particles[i];
    ctx.globalAlpha = Math.min(1, p.life / 30);
    ctx.fillStyle = p.color;
    ctx.beginPath();
    ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
    ctx.fill();
  }
  ctx.globalAlpha = 1;
}

function resizeCanvas() {
  var rect = canvas.parentElement.getBoundingClientRect();
  var aspect = W / H;
  var dw = rect.width, dh = rect.height;
  if (dw / dh > aspect) dw = dh * aspect; else dh = dw / aspect;
  canvas.style.width = dw + 'px';
  canvas.style.height = dh + 'px';
  var dpr = Math.min(window.devicePixelRatio || 1, 2);
  canvas.width = W * dpr; canvas.height = H * dpr;
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  ctx.imageSmoothingEnabled = true;
}
window.addEventListener('resize', resizeCanvas);
window.addEventListener('orientationchange', function() { setTimeout(resizeCanvas, 250); });

function rr(c, x, y, w, h, r) {
  c.beginPath();
  c.moveTo(x+r, y); c.lineTo(x+w-r, y);
  c.quadraticCurveTo(x+w, y, x+w, y+r);
  c.lineTo(x+w, y+h-r); c.quadraticCurveTo(x+w, y+h, x+w-r, y+h);
  c.lineTo(x+r, y+h); c.quadraticCurveTo(x, y+h, x, y+h-r);
  c.lineTo(x, y+r); c.quadraticCurveTo(x, y, x+r, y); c.closePath();
}

function lighten(hex, percent) {
  var num = parseInt(hex.replace('#',''), 16);
  var r = (num >> 16) + percent;
  var g = ((num >> 8) & 0x00FF) + percent;
  var b = (num & 0x0000FF) + percent;
  r = Math.min(255, Math.max(0, r));
  g = Math.min(255, Math.max(0, g));
  b = Math.min(255, Math.max(0, b));
  return '#' + ((r << 16) | (g << 8) | b).toString(16).padStart(6, '0');
}

function drawCar(x, y, w, h, color, isPlayer) {
  ctx.save();
  ctx.fillStyle = 'rgba(0,0,0,0.35)';
  rr(ctx, x-w/2+3, y-h/2+4, w, h, 8); ctx.fill();

  var grad = ctx.createLinearGradient(x-w/2, 0, x+w/2, 0);
  grad.addColorStop(0, color);
  grad.addColorStop(0.5, lighten(color, 20));
  grad.addColorStop(1, color);
  ctx.fillStyle = grad;
  rr(ctx, x-w/2, y-h/2, w, h, 8); ctx.fill();

  ctx.strokeStyle = 'rgba(0,0,0,0.4)';
  ctx.lineWidth = 1;
  rr(ctx, x-w/2, y-h/2, w, h, 8); ctx.stroke();

  ctx.fillStyle = 'rgba(255,255,255,0.25)';
  ctx.beginPath();
  ctx.moveTo(x-w/2+3, y-h/2+12);
  ctx.lineTo(x-w/2+3, y+h/2-12);
  ctx.lineTo(x-w/2+5, y+h/2-14);
  ctx.lineTo(x-w/2+5, y-h/2+14);
  ctx.closePath();
  ctx.fill();
  ctx.beginPath();
  ctx.moveTo(x+w/2-5, y-h/2+12);
  ctx.lineTo(x+w/2-5, y+h/2-12);
  ctx.lineTo(x+w/2-3, y+h/2-14);
  ctx.lineTo(x+w/2-3, y-h/2+14);
  ctx.closePath();
  ctx.fill();

  ctx.fillStyle = isPlayer ? 'rgba(180,230,255,0.85)' : 'rgba(120,180,220,0.8)';
  rr(ctx, x-w/2+5, y-h/2+6, w-10, 14, 3); ctx.fill();
  ctx.fillStyle = 'rgba(255,255,255,0.5)';
  rr(ctx, x-w/2+7, y-h/2+7, 6, 12, 2); ctx.fill();

  ctx.strokeStyle = 'rgba(0,0,0,0.3)';
  ctx.lineWidth = 1.5;
  ctx.beginPath();
  ctx.moveTo(x-w/2+4, y-h/2+22);
  ctx.lineTo(x+w/2-4, y-h/2+22);
  ctx.stroke();

  var roofGrad = ctx.createLinearGradient(x-w/2, y-h/2+22, x-w/2, y+h/2-14);
  roofGrad.addColorStop(0, 'rgba(0,0,0,0.35)');
  roofGrad.addColorStop(0.5, 'rgba(0,0,0,0.15)');
  roofGrad.addColorStop(1, 'rgba(0,0,0,0.35)');
  ctx.fillStyle = roofGrad;
  rr(ctx, x-w/2+5, y-h/2+22, w-10, h-36, 4); ctx.fill();

  ctx.strokeStyle = 'rgba(255,255,255,0.1)';
  ctx.lineWidth = 1;
  ctx.beginPath();
  ctx.moveTo(x-3, y-h/2+22); ctx.lineTo(x-3, y+h/2-14); ctx.stroke();
  ctx.beginPath();
  ctx.moveTo(x+3, y-h/2+22); ctx.lineTo(x+3, y+h/2-14); ctx.stroke();

  ctx.fillStyle = 'rgba(120,180,220,0.7)';
  rr(ctx, x-w/2+6, y+h/2-16, w-12, 10, 3); ctx.fill();

  ctx.fillStyle = '#1a1a1a';
  ctx.fillRect(x-w/2-4, y-h/2+8, 5, 14);
  ctx.fillRect(x+w/2-1, y-h/2+8, 5, 14);
  ctx.fillRect(x-w/2-4, y+h/2-22, 5, 14);
  ctx.fillRect(x+w/2-1, y+h/2-22, 5, 14);
  ctx.fillStyle = '#333';
  ctx.fillRect(x-w/2-3, y-h/2+10, 3, 10);
  ctx.fillRect(x+w/2, y-h/2+10, 3, 10);
  ctx.fillRect(x-w/2-3, y+h/2-20, 3, 10);
  ctx.fillRect(x+w/2, y+h/2-20, 3, 10);

  ctx.shadowColor = '#ffff88';
  ctx.shadowBlur = isPlayer ? 12 : 6;
  ctx.fillStyle = '#ffff88';
  if (isPlayer) {
    ctx.fillRect(x-w/2+5, y-h/2-2, 8, 4);
    ctx.fillRect(x+w/2-13, y-h/2-2, 8, 4);
    ctx.fillStyle = 'rgba(255,255,150,0.5)';
    ctx.beginPath();
    ctx.moveTo(x-w/2+5, y-h/2-2);
    ctx.lineTo(x-w/2-6, y-h/2-12);
    ctx.lineTo(x-w/2+13, y-h/2-12);
    ctx.lineTo(x-w/2+13, y-h/2-2);
    ctx.closePath();
    ctx.fill();
    ctx.beginPath();
    ctx.moveTo(x+w/2-13, y-h/2-2);
    ctx.lineTo(x+w/2-13, y-h/2-12);
    ctx.lineTo(x+w/2+6, y-h/2-12);
    ctx.lineTo(x+w/2-5, y-h/2-2);
    ctx.closePath();
    ctx.fill();
  } else {
    ctx.fillRect(x-w/2+5, y+h/2-2, 8, 4);
    ctx.fillRect(x+w/2-13, y+h/2-2, 8, 4);
  }
  ctx.shadowBlur = 0;

  ctx.shadowColor = '#ff4444';
  ctx.shadowBlur = 8;
  ctx.fillStyle = '#ff2222';
  if (isPlayer) {
    ctx.fillRect(x-w/2+5, y+h/2-2, 7, 3);
    ctx.fillRect(x+w/2-12, y+h/2-2, 7, 3);
  } else {
    ctx.fillRect(x-w/2+5, y-h/2-1, 7, 3);
    ctx.fillRect(x+w/2-12, y-h/2-1, 7, 3);
  }
  ctx.shadowBlur = 0;
  ctx.restore();
}

function drawRoad() {
  var env = ENVIRONMENTS[currentEnv] || ENVIRONMENTS.highway;
  ctx.fillStyle = env.grass;
  ctx.fillRect(0, 0, GRASS_W, H);
  ctx.fillRect(W-GRASS_W, 0, GRASS_W, H);
  ctx.fillStyle = env.road;
  ctx.fillRect(GRASS_W, 0, ROAD_W, H);
  ctx.fillStyle = env.line;
  ctx.fillRect(GRASS_W+4, 0, 3, H);
  ctx.fillRect(W-GRASS_W-7, 0, 3, H);
  ctx.fillStyle = '#ffffff';
  var dL = 30, gL = 25, t = dL + gL, off = roadScroll % t;
  for (var li = 1; li < LANE_COUNT; li++) {
    var lx = GRASS_W + LANE_W * li - 1.5;
    for (var y = -t + off; y < H; y += t) ctx.fillRect(lx, y, 3, dL);
  }
}

function drawEnvEffects() {
  if (currentEnv === 'rain') {
    ctx.strokeStyle = 'rgba(174,194,224,0.5)';
    ctx.lineWidth = 1;
    for (var i = 0; i < 30; i++) {
      var x = (Date.now() * 0.3 + i * 50) % W;
      var y = (Date.now() * 0.8 + i * 30) % H;
      ctx.beginPath();
      ctx.moveTo(x, y);
      ctx.lineTo(x - 3, y + 15);
      ctx.stroke();
    }
  } else if (currentEnv === 'snow') {
    ctx.fillStyle = 'rgba(255,255,255,0.8)';
    for (var j = 0; j < 25; j++) {
      var sx = (Math.sin(Date.now() * 0.001 + j) * W + j * 40) % W;
      var sy = (Date.now() * 0.2 + j * 40) % H;
      ctx.beginPath();
      ctx.arc(sx, sy, 2, 0, Math.PI * 2);
      ctx.fill();
    }
  } else if (currentEnv === 'night') {
    ctx.fillStyle = 'rgba(0,0,30,0.3)';
    ctx.fillRect(0, 0, W, H);
  } else if (currentEnv === 'city') {
    ctx.fillStyle = 'rgba(255,200,100,0.05)';
    ctx.fillRect(0, 0, W, H);
  }
}

