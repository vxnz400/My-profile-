function tickRound() {
  tickCounter++;
  if (roundData.endMs > 0) {
    var now = Date.now();
    var left = Math.max(0, Math.floor((roundData.endMs - now) / 1000));
    barTimer.textContent = fmt(left);
    modalTimer.textContent = fmt(left);
    roundData.secondsRemaining = left;
    if (left === 0 && gameActive) {
      var fs = score, fr = roundData.id;
      var ov = totalOvertakesInRound, bs = bestStreakInRound;
      endGameRound();
      if (currentUser && roundData.isJoined && lastRoundIdSentScore !== fr) {
        lastRoundIdSentScore = fr;
        callAPI('submitRoundScore', { username: currentUser.username, score: fs, roundId: fr, overtakes: ov, bestStreak: bs });
        callAPI('updateScore', { username: currentUser.username, score: fs });
      }
    }
    if (left === 0) fetchRoundStatus();
    else if (tickCounter % 3 === 0) fetchRoundStatus();
  }
  maybeStartGame();
}

