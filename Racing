function updateStateBadge() {
  if (!roundData.isJoined) stateBadge.textContent = t('notJoined');
  else if (isPaused) stateBadge.textContent = t('paused');
  else if (gameActive) stateBadge.textContent = '🏁 ' + t('active');
  else if (isCountdownActive) stateBadge.textContent = '⏳';
  else stateBadge.textContent = '⏸️ ' + t('waiting');
}
function resetGame() {
  if (countdownInterval) { clearInterval(countdownInterval); countdownInterval = null; }
  isCountdownActive = false; gameActive = false; isPaused = false;
  pauseOverlay.classList.remove('show');
  pauseBtn.classList.remove('paused'); pauseBtn.textContent = '⏸';
  playerX = W / 2;
  enemyCars = []; roadScroll = 0; playerSpeed = 3;
  score = 0; frame = 0; spawnTimer = 0; currentSpawnInterval = 70;
  currentStreak = 0; bestStreakInRound = 0; totalOvertakesInRound = 0;
  particles = []; sideObjects = []; lastSideSpawnY = 0;
  stopEngine(); updateDisplay(); updateStateBadge();
}
function maybeStartGame() {
  if (!currentUser) return;
  if (!roundData.isJoined) return;
  if (roundData.secondsRemaining <= 3) return;
  if (gameActive || isCountdownActive) return;
  if (isPaused) return;
  startPlaying();
}
function startPlaying() {
  if (gameActive || isCountdownActive) return;
  resetGame();
  isCountdownActive = true;
  var c = 3;
  countdownOverlay.textContent = c;
  countdownOverlay.classList.add('show');
  beep(600, 0.15, 0.15);
  countdownInterval = setInterval(function() {
    c--;
    if (c > 0) {
      countdownOverlay.textContent = c;
      beep(600, 0.15, 0.15);
    } else {
      clearInterval(countdownInterval); countdownInterval = null;
      countdownOverlay.classList.remove('show');
      isCountdownActive = false; gameActive = true;
      beep(1000, 0.3, 0.2);
      setTimeout(function() { beep(1200, 0.2, 0.18); }, 150);
      initAudio();
      if (!musicMuted && !engineRunning) {
        if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume();
        startEngine();
      }
      updateStateBadge();
    }
  }, 1000);
}
function endGameRound() {
  if (countdownInterval) { clearInterval(countdownInterval); countdownInterval = null; }
  isCountdownActive = false; gameActive = false;
  stopEngine(); updateStateBadge();
}
function updateDisplay() {
  scoreSpan.textContent = score;
  speedSpan.textContent = Math.floor(playerSpeed * 20);
  if (currentUser) balanceDisplay.textContent = currentUser.balance;
}
function spawnEnemy() {
  var lane = Math.floor(Math.random() * LANE_COUNT);
  var baseX = LANE_CENTERS[lane];
  var x = baseX + (Math.random() - 0.5) * (LANE_W - ENEMY_W - 10);
  enemyCars.push({
    x: x, y: -ENEMY_H - 10, w: ENEMY_W, h: ENEMY_H,
    color: CAR_COLORS[Math.floor(Math.random() * CAR_COLORS.length)]
  });
}
function update() {
  if (!gameActive || isPaused) return;
  if (roundData.endMs > 0 && Date.now() >= roundData.endMs) {
    var fs = score, fr = roundData.id;
    var ov = totalOvertakesInRound, bs = bestStreakInRound;
    endGameRound();
    if (currentUser && roundData.isJoined && lastRoundIdSentScore !== fr) {
      lastRoundIdSentScore = fr;
      callAPI('submitRoundScore', { username: currentUser.username, score: fs, roundId: fr, overtakes: ov, bestStreak: bs });
      callAPI('updateScore', { username: currentUser.username, score: fs });
    }
    return;
  }
  frame++;
  playerSpeed = Math.min(9, 3 + Math.floor(frame / 500) * 0.8);
  currentSpawnInterval = Math.max(30, 70 - Math.floor(frame / 300) * 5);
  roadScroll += playerSpeed;
  if (movingLeft) playerX -= MOVE_SPEED;
  if (movingRight) playerX += MOVE_SPEED;
  var minX = GRASS_W + PLAYER_W/2 + 4, maxX = W - GRASS_W - PLAYER_W/2 - 4;
  if (playerX < minX) playerX = minX;
  if (playerX > maxX) playerX = maxX;
  spawnTimer++;
  if (spawnTimer >= currentSpawnInterval) {
    spawnTimer = 0; spawnEnemy();
    if (playerSpeed > 5 && Math.random() < 0.3) spawnEnemy();
  }
  for (var i = enemyCars.length - 1; i >= 0; i--) {
    var car = enemyCars[i];
    car.y += playerSpeed * 1.4;
    if (Math.abs(car.x - playerX) < (car.w + PLAYER_W)/2 - 6 &&
        Math.abs(car.y - playerY) < (car.h + PLAYER_H)/2 - 6) {
      enemyCars.splice(i, 1);
      score = Math.max(0, score - 1);
      currentStreak = 0;
      crashSound();
      addParticle(playerX, playerY - 20, '#ff4444', 8);
      updateDisplay();
      continue;
    }
    if (car.y > H + 50) {
      enemyCars.splice(i, 1);
      score += 1;
      currentStreak++;
      totalOvertakesInRound++;
      if (currentStreak > bestStreakInRound) bestStreakInRound = currentStreak;
      addParticle(car.x, H, '#ffd966', 3);
      updateDisplay();
    }
  }
  updateParticles();
  updateSideObjects();
  updateEngineSound();
}
function draw() {
  ctx.clearRect(0, 0, W, H);
  drawRoad();
  drawSideObjects();
  drawEnvEffects();
  for (var i = 0; i < enemyCars.length; i++) {
    var c = enemyCars[i];
    drawCar(c.x, c.y, c.w, c.h, c.color, false);
  }
  if (gameActive || isCountdownActive || isPaused) {
    var playerColor = CAR_MAP[roundData.activeCar] || '#e63946';
    drawCar(playerX, playerY, PLAYER_W, PLAYER_H, playerColor, true);
  }
  drawParticles();
  if (!roundData.isJoined) {
    ctx.fillStyle = 'rgba(0,0,0,0.7)';
    ctx.fillRect(0, 0, W, H);
    ctx.font = 'bold 24px sans-serif'; ctx.fillStyle = '#ffd966'; ctx.textAlign = 'center';
    ctx.fillText('🎫 ' + t('notJoined'), W/2, H/2 - 20);
    ctx.font = '16px sans-serif'; ctx.fillStyle = '#fff';
    ctx.fillText(t('join') + ' (1 ' + t('point') + ')', W/2, H/2 + 20);
  } else if (!gameActive && !isCountdownActive && !isPaused) {
    ctx.fillStyle = 'rgba(0,0,0,0.7)';
    ctx.fillRect(0, 0, W, H);
    ctx.font = 'bold 24px sans-serif'; ctx.fillStyle = '#ffd966'; ctx.textAlign = 'center';
    ctx.fillText('⏳ ' + t('waiting'), W/2, H/2 - 20);
    ctx.font = '16px sans-serif'; ctx.fillStyle = '#fff';
    ctx.fillText(t('round') + ' #' + roundNum(roundData.id), W/2, H/2 + 20);
  }
}
function gameLoop() { update(); draw(); requestAnimationFrame(gameLoop); }

function pauseGame() {
  if (isPaused || (!gameActive && !isCountdownActive)) return;
  isPaused = true;
  if (engineSound && engineSound.gain) engineSound.gain.gain.value = 0;
  pauseScore.textContent = score;
  pauseState.textContent = t('round') + ' #' + roundNum(roundData.id);
  pauseOverlay.classList.add('show');
  pauseBtn.textContent = '▶'; pauseBtn.classList.add('paused');
  updateStateBadge();
}
function resumeGame() {
  if (!isPaused) return;
  isPaused = false;
  if (engineSound && engineSound.gain) {
    var sf = (playerSpeed - 3) / 6;
    engineSound.gain.gain.value = musicMuted ? 0 : (0.08 + sf * 0.12);
  }
  pauseOverlay.classList.remove('show');
  pauseBtn.textContent = '⏸'; pauseBtn.classList.remove('paused');
  updateStateBadge();
}
pauseBtn.addEventListener('click', function(e) { e.stopPropagation(); isPaused ? resumeGame() : pauseGame(); });
resumeBtn.addEventListener('click', function(e) { e.stopPropagation(); resumeGame(); });

function setupHold(btn, setter) {
  var s = function(e) { e.preventDefault(); setter(true); btn.classList.add('pressed'); };
  var t = function(e) { if (e) e.preventDefault(); setter(false); btn.classList.remove('pressed'); };
  btn.addEventListener('mousedown', s);
  btn.addEventListener('mouseup', t);
  btn.addEventListener('mouseleave', t);
  btn.addEventListener('touchstart', s, { passive: false });
  btn.addEventListener('touchend', t, { passive: false });
  btn.addEventListener('touchcancel', t, { passive: false });
  btn.addEventListener('pointerdown', s, { passive: false });
  btn.addEventListener('pointerup', t, { passive: false });
  btn.addEventListener('pointerleave', t, { passive: false });
}
setupHold(leftBtn, function(v) { movingLeft = v; });
setupHold(rightBtn, function(v) { movingRight = v; });

document.addEventListener('keydown', function(e) {
  if (e.key === 'ArrowLeft' || e.key === 'a' || e.key === 'A') movingLeft = true;
  if (e.key === 'ArrowRight' || e.key === 'd' || e.key === 'D') movingRight = true;
  if (e.key === ' ' || e.key === 'p' || e.key === 'P' || e.key === 'Escape') {
    e.preventDefault();
    isPaused ? resumeGame() : pauseGame();
  }
});
document.addEventListener('keyup', function(e) {
  if (e.key === 'ArrowLeft' || e.key === 'a' || e.key === 'A') movingLeft = false;
  if (e.key === 'ArrowRight' || e.key === 'd' || e.key === 'D') movingRight = false;
});

var dragging = false;
canvas.addEventListener('touchstart', function() { dragging = true; }, { passive: true });
canvas.addEventListener('touchmove', function(e) {
  if (!dragging) return;
  var touch = e.touches[0]; if (!touch) return;
  var rect = canvas.getBoundingClientRect();
  var cx = (touch.clientX - rect.left) * (W / rect.width);
  var minX = GRASS_W + PLAYER_W/2 + 4;
  var maxX = W - GRASS_W - PLAYER_W/2 - 4;
  playerX = Math.max(minX, Math.min(maxX, cx));
}, { passive: true });
canvas.addEventListener('touchend', function() { dragging = false; }, { passive: true });

function callAPI(action, data) {
  return fetch(SCRIPT_URL, {
    method: 'POST', mode: 'cors', redirect: 'follow',
    headers: { 'Content-Type': 'text/plain;charset=utf-8' },
    body: JSON.stringify(Object.assign({ action: action }, data || {}))
  })
  .then(function(r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.text(); })
  .then(function(txt) { try { return JSON.parse(txt); } catch(e) { throw new Error('JSON'); } });
}

function colorOf(s) {
  var h = 0; for (var i = 0; i < s.length; i++) h = s.charCodeAt(i) + ((h << 5) - h);
  return 'hsl(' + (Math.abs(h) % 360) + ', 60%, 50%)';
}
function avHtml(u, url) {
  if (url && url.indexOf('data:image') === 0) return '<img src="' + url + '">';
  return '<span>' + (u || '?').charAt(0).toUpperCase() + '</span>';
}
function avStyle(u, url) {
  if (url && url.indexOf('data:image') === 0) return '';
  return 'background:' + colorOf(u) + ';';
}
function esc(s) {
  return String(s).replace(/[&<>"']/g, function(m) {
    return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[m];
  });
}
function fmt(s) { if (s < 0) s = 0; return String(Math.floor(s / 60)).padStart(2, '0') + ':' + String(s % 60).padStart(2, '0'); }
function roundNum(id) {
  var d = new Date(id);
  var mid = Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate());
  return Math.floor((id - mid) / 120000) + 1;
}

