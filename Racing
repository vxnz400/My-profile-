function showTradeStatus(txt, type) {
  tradeStatus.textContent = txt;
  tradeStatus.className = 'trade-status' + (type ? ' ' + type : '');
  if (type === 'success') setTimeout(function() { tradeStatus.textContent = ''; tradeStatus.className = 'trade-status'; }, 4000);
}
function requestTx(type) {
  if (!currentUser) { showTradeStatus('❌'); return; }
  var pts = parseInt(tradePoints.value);
  if (!pts || pts < 1) { showTradeStatus('❌'); return; }
  if (type === 'sell' && pts < 100) { showTradeStatus('❌ 100 min'); return; }
  if (type === 'buy' && pts < 20) { showTradeStatus('❌ 20 min'); return; }
  if (pts > 10000) { showTradeStatus('❌ 10000 max'); return; }
  if (type === 'sell' && currentUser.balance < pts) { showTradeStatus('❌'); return; }
  var btn = type === 'buy' ? buyBtn : sellBtn;
  var orig = btn.textContent;
  btn.disabled = true; btn.textContent = '⏳...';
  callAPI('requestTx', { username: currentUser.username, type: type, points: pts })
  .then(function(r) {
    btn.disabled = false; btn.textContent = orig;
    if (r.success) { showTradeStatus('✅ ' + r.message, 'success'); tradePoints.value = ''; fetchTxHistory(); }
    else showTradeStatus('❌ ' + (r.message || ''));
  })
  .catch(function() { btn.disabled = false; btn.textContent = orig; showTradeStatus('❌'); });
}
function fetchTxHistory() {
