// ============ الجولة ============
function fetchRoundStatus() {
  return callAPI('roundStatus', { username: currentUser ? currentUser.username : '' })
  .then(function(r) {
    if (!r.success) return;
    var prevRoundId = roundData.id;
    var prevIsJoined = roundData.isJoined;
    var prevScore = score;

    if (prevRoundId !== 0 && prevRoundId !== r.round.id && prevIsJoined && currentUser && lastRoundIdSentScore !== prevRoundId) {
      lastRoundIdSentScore = prevRoundId;
      callAPI('submitRoundScore', { username: currentUser.username, score: prevScore, roundId: prevRoundId });
      callAPI('updateScore', { username: currentUser.username, score: prevScore });
    }

    roundData.id = r.round.id;
    roundData.endMs = r.round.endMs;
    roundData.playersCount = r.round.playersCount;
    roundData.prizePool = r.round.prizePool;
    roundData.prizes = r.round.prizes || [0,0,0];
    roundData.secondsRemaining = r.round.secondsRemaining;
    roundData.entryCost = r.entryCost || 1;
    roundData.isJoined = !!r.myEntry;
    roundData.participants = r.participants || [];
    roundData.myEntry = r.myEntry;
    roundData.autoJoin = r.autoJoin || 0;
    if (r.activeCar) roundData.activeCar = r.activeCar;

    // تبديل خلفية الجولة تلقائياً
    updateRoundBackground();

    if (r.user && currentUser) {
      currentUser.balance = r.user.balance;
      currentUser.totalWon = r.user.totalWon;
      currentUser.totalSpent = r.user.totalSpent;
      displayBalance.textContent = r.user.balance;
      balanceDisplay.textContent = r.user.balance;
      tradeBalance.textContent = r.user.balance;
      shopBalance.textContent = r.user.balance;
    }

    if (prevRoundId !== 0 && prevRoundId !== roundData.id) {
      endGameRound();
      previousRoundCache = null;
      if (rightPanelMode === 'previous') fetchPrevForPanel();
    }

    if (roundData.secondsRemaining <= 0 && gameActive) {
      var fs = score, fr = roundData.id;
      var ov = totalOvertakesInRound, bs = bestStreakInRound;
      endGameRound();
      if (currentUser && roundData.isJoined && lastRoundIdSentScore !== fr) {
        lastRoundIdSentScore = fr;
        callAPI('submitRoundScore', { username: currentUser.username, score: fs, roundId: fr, overtakes: ov, bestStreak: bs });
        callAPI('updateScore', { username: currentUser.username, score: fs });
      }
    }

    updateRoundUI();
    renderCurrentResults();
    renderRightPanel();
    maybeStartGame();
  })
  .catch(function() {});
}

function updateRoundUI() {
  var rn = roundNum(roundData.id);
  barRoundNum.textContent = '#' + rn;
  modalRoundNum.innerHTML = '🎯 ' + t('round') + ' #' + rn;
  barPlayers.textContent = roundData.playersCount;
  modalPlayers.textContent = roundData.playersCount;
  barPrize.textContent = roundData.prizePool;
  modalPool.textContent = roundData.prizePool;
  modalCost.textContent = roundData.entryCost;
  prize1.textContent = roundData.prizes[0] + ' ⭐';
  prize2.textContent = roundData.prizes[1] + ' ⭐';
  prize3.textContent = roundData.prizes[2] + ' ⭐';
  var s = t('waiting'), c = 'waiting';
  if (roundData.secondsRemaining > 0) { s = t('active'); c = 'active'; }
  else { s = t('ended'); c = 'ended'; }
  barStatus.textContent = s;
  barStatus.className = 'status-badge ' + c;
  if (roundData.autoJoin) barAutoChip.style.display = 'inline-flex';
  else barAutoChip.style.display = 'none';
  if (!currentUser) { barJoinBtn.textContent = t('login'); barJoinBtn.classList.remove('leave'); }
  else if (roundData.isJoined) { barJoinBtn.textContent = '✓'; barJoinBtn.classList.add('leave'); }
  else { barJoinBtn.textContent = t('join'); barJoinBtn.classList.remove('leave'); }
  autoJoinToggle.checked = !!roundData.autoJoin;
  updateModalButtons();
  updateStateBadge();
}

function updateModalButtons() {
  var bj = modalJoinBtn, bl = modalLeaveBtn;
  if (!currentUser) { bj.disabled = true; bj.textContent = t('login'); bl.style.display = 'none'; return; }
  if (roundData.isJoined) {
    bj.style.display = 'none'; bl.style.display = 'block';
    var hasScore = roundData.myEntry && roundData.myEntry.score > 0;
    bl.disabled = !!hasScore;
    bl.textContent = hasScore ? '-' : '🚪 ' + t('leave');
  } else {
    bj.style.display = 'block'; bl.style.display = 'none';
    var ok = currentUser.balance >= roundData.entryCost && roundData.secondsRemaining > 30;
    bj.disabled = !ok;
    if (currentUser.balance < roundData.entryCost) bj.textContent = '❌';
    else if (roundData.secondsRemaining <= 30) bj.textContent = '⏰';
    else bj.textContent = '🎫 ' + t('join') + ' (' + roundData.entryCost + ' ' + t('point') + ')';
  }
}

