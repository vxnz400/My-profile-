function fetchShop() {
  shopGrid.innerHTML = '<div class="tx-empty">' + t('loading') + '</div>';
  Promise.all([
    callAPI('getShop', {}),
    currentUser ? callAPI('getInventory', { username: currentUser.username }) : Promise.resolve({ success: true, inventory: [] })
  ])
  .then(function(results) {
    if (results[0].success) {
      shopItems = results[0].items || [];
      inventory = (results[1] && results[1].inventory) || [];
      renderShop();
    }
  })
  .catch(function() { shopGrid.innerHTML = '<div class="tx-empty">⚠️</div>'; });
}
function renderShop() {
  if (!shopItems.length) { shopGrid.innerHTML = '<div class="tx-empty">-</div>'; return; }
  var h = '';
  for (var i = 0; i < shopItems.length; i++) {
    var item = shopItems[i];
    var owned = inventory.indexOf(item.id) !== -1;
    var isActive = currentUser && roundData.activeCar === item.id;
    var cls = 'shop-card';
    if (isActive) cls += ' active-car';
    else if (owned) cls += ' owned';
    h += '<div class="' + cls + '">';
    h += '<div class="shop-car-preview" style="background:' + item.color + ';"></div>';
    h += '<div class="shop-name">' + esc(item.name) + '</div>';
    h += '<div class="shop-price">' + (item.price > 0 ? '💰 ' + item.price : '🎁') + '</div>';
    if (isActive) h += '<button class="shop-buy-btn active-btn" disabled>✓</button>';
    else if (owned) h += '<button class="shop-buy-btn activate" data-activate="' + item.id + '">🎯</button>';
    else {
      var canBuy = currentUser && currentUser.balance >= item.price;
      h += '<button class="shop-buy-btn" data-buy="' + item.id + '"' + (canBuy ? '' : ' disabled') + '>' + (canBuy ? '🛒' : '❌') + '</button>';
    }
    h += '</div>';
  }
  shopGrid.innerHTML = h;
  shopGrid.querySelectorAll('[data-buy]').forEach(function(btn) {
    btn.addEventListener('click', function() { buyItem(this.getAttribute('data-buy')); });
  });
  shopGrid.querySelectorAll('[data-activate]').forEach(function(btn) {
    btn.addEventListener('click', function() { setActiveCar(this.getAttribute('data-activate')); });
  });
}
