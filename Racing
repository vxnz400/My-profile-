function spawnSideObject() {
  var env = ENV_SIDE_OBJECTS[currentEnv] || ENV_SIDE_OBJECTS.highway;
  var picked = env[0];
  var r = Math.random(), acc = 0;
  for (var i = 0; i < env.length; i++) {
    acc += env[i].chance;
    if (r <= acc) { picked = env[i]; break; }
  }
  var color = picked.colors[Math.floor(Math.random() * picked.colors.length)];
  var side = Math.random() < 0.5 ? 'left' : 'right';
  var size = picked.type === 'building' ? (35 + Math.random() * 25) : (18 + Math.random() * 18);
  sideObjects.push({
    x: side === 'left' ? Math.random() * (GRASS_W - 5) : W - GRASS_W + Math.random() * (GRASS_W - 5),
    y: -size - 10,
    type: picked.type,
    color: color,
    size: size,
    lit: !!picked.lit,
    windowPhase: Math.random() * 10,
    variant: Math.floor(Math.random() * 3),
    hasTree: Math.random() < 0.3
  });
}

function updateSideObjects() {
  if (frame - lastSideSpawnY > 40) {
    lastSideSpawnY = frame;
    if (Math.random() < 0.65) spawnSideObject();
  }
  for (var i = sideObjects.length - 1; i >= 0; i--) {
    var o = sideObjects[i];
    o.y += playerSpeed;
    if (o.y > H + 80) sideObjects.splice(i, 1);
  }
}

function drawSideObjects() {
  for (var i = 0; i < sideObjects.length; i++) {
    var o = sideObjects[i];
    var x = o.x, y = o.y, s = o.size;
    ctx.save();

    if (o.type === 'tree') {
      ctx.fillStyle = 'rgba(0,0,0,0.2)';
      ctx.beginPath(); ctx.ellipse(x, y + s * 0.45, s * 0.5, s * 0.15, 0, 0, Math.PI * 2); ctx.fill();
      ctx.fillStyle = '#5d4037';
      ctx.fillRect(x - s * 0.08, y, s * 0.16, s * 0.5);
      ctx.fillStyle = 'rgba(0,0,0,0.2)';
      ctx.fillRect(x + s * 0.02, y, s * 0.06, s * 0.5);
      ctx.fillStyle = o.color;
      ctx.beginPath(); ctx.arc(x, y - s * 0.15, s * 0.5, 0, Math.PI * 2); ctx.fill();
      ctx.beginPath(); ctx.arc(x - s * 0.25, y + s * 0.05, s * 0.35, 0, Math.PI * 2); ctx.fill();
      ctx.beginPath(); ctx.arc(x + s * 0.25, y + s * 0.05, s * 0.35, 0, Math.PI * 2); ctx.fill();
      ctx.strokeStyle = 'rgba(0,0,0,0.15)';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(x - s * 0.15, y - s * 0.3);
      ctx.lineTo(x + s * 0.15, y - s * 0.1);
      ctx.stroke();
      ctx.fillStyle = 'rgba(255,255,255,0.25)';
      ctx.beginPath(); ctx.arc(x - s * 0.15, y - s * 0.25, s * 0.15, 0, Math.PI * 2); ctx.fill();
    } else if (o.type === 'bush') {
      ctx.fillStyle = 'rgba(0,0,0,0.2)';
      ctx.beginPath(); ctx.ellipse(x, y + s * 0.25, s * 0.5, s * 0.15, 0, 0, Math.PI * 2); ctx.fill();
      ctx.fillStyle = o.color;
      ctx.beginPath(); ctx.arc(x, y, s * 0.4, 0, Math.PI * 2); ctx.fill();
      ctx.beginPath(); ctx.arc(x - s * 0.3, y + s * 0.1, s * 0.3, 0, Math.PI * 2); ctx.fill();
      ctx.beginPath(); ctx.arc(x + s * 0.3, y + s * 0.1, s * 0.3, 0, Math.PI * 2); ctx.fill();
      ctx.fillStyle = 'rgba(255,255,255,0.15)';
      ctx.beginPath(); ctx.arc(x - s * 0.15, y - s * 0.15, s * 0.15, 0, Math.PI * 2); ctx.fill();
    } else if (o.type === 'palm') {
      ctx.strokeStyle = '#8d6e63';
      ctx.lineWidth = s * 0.14;
      ctx.beginPath();
      ctx.moveTo(x, y + s * 0.3);
      ctx.quadraticCurveTo(x + s * 0.15, y - s * 0.5, x + s * 0.05, y - s);
      ctx.stroke();
      ctx.strokeStyle = 'rgba(0,0,0,0.2)';
      ctx.lineWidth = 1;
      for (var gg = 0; gg < 4; gg++) {
        ctx.beginPath();
        ctx.moveTo(x - s * 0.05, y + s * 0.15 - gg * s * 0.25);
        ctx.lineTo(x + s * 0.08, y + s * 0.12 - gg * s * 0.25);
        ctx.stroke();
      }
      var hx = x + s * 0.05, hy = y - s;
      ctx.fillStyle = '#558b2f';
      for (var a = 0; a < 6; a++) {
        var ang = -Math.PI / 2 + (a - 2.5) * 0.55;
        ctx.beginPath();
        ctx.ellipse(hx + Math.cos(ang) * s * 0.35, hy + Math.sin(ang) * s * 0.35,
                    s * 0.38, s * 0.1, ang, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.fillStyle = '#5d4037';
      ctx.beginPath(); ctx.arc(hx - s * 0.1, hy + s * 0.15, s * 0.08, 0, Math.PI * 2); ctx.fill();
      ctx.beginPath(); ctx.arc(hx + s * 0.1, hy + s * 0.15, s * 0.08, 0, Math.PI * 2); ctx.fill();
    } else if (o.type === 'rock') {
      ctx.fillStyle = 'rgba(0,0,0,0.25)';
      ctx.beginPath(); ctx.ellipse(x, y + s * 0.3, s * 0.6, s * 0.15, 0, 0, Math.PI * 2); ctx.fill();
      ctx.fillStyle = o.color;
      ctx.beginPath();
      ctx.moveTo(x - s * 0.5, y + s * 0.3);
      ctx.lineTo(x - s * 0.35, y - s * 0.15);
      ctx.lineTo(x - s * 0.1, y - s * 0.4);
      ctx.lineTo(x + s * 0.15, y - s * 0.35);
      ctx.lineTo(x + s * 0.5, y - s * 0.05);
      ctx.lineTo(x + s * 0.45, y + s * 0.3);
      ctx.closePath();
      ctx.fill();
      ctx.fillStyle = 'rgba(0,0,0,0.2)';
      ctx.beginPath(); ctx.arc(x - s * 0.2, y + s * 0.05, s * 0.08, 0, Math.PI * 2); ctx.fill();
      ctx.beginPath(); ctx.arc(x + s * 0.2, y + s * 0.15, s * 0.06, 0, Math.PI * 2); ctx.fill();
      ctx.fillStyle = 'rgba(255,255,255,0.3)';
      ctx.beginPath();
      ctx.moveTo(x - s * 0.25, y - s * 0.15);
      ctx.lineTo(x + s * 0.05, y - s * 0.3);
      ctx.lineTo(x, y - s * 0.1);
      ctx.closePath();
      ctx.fill();
    } else if (o.type === 'building') {
      ctx.fillStyle = 'rgba(0,0,0,0.3)';
      ctx.fillRect(x - s * 0.55, y - s * 1.55, s * 1.1, s * 1.9);
      var bGrad = ctx.createLinearGradient(x - s * 0.5, 0, x + s * 0.5, 0);
      bGrad.addColorStop(0, o.color);
      bGrad.addColorStop(0.4, lighten(o.color, 15));
      bGrad.addColorStop(1, o.color);
      ctx.fillStyle = bGrad;
      ctx.fillRect(x - s * 0.5, y - s * 1.5, s, s * 1.8);
      ctx.strokeStyle = 'rgba(0,0,0,0.4)';
      ctx.lineWidth = 1.5;
      ctx.strokeRect(x - s * 0.5, y - s * 1.5, s, s * 1.8);
      ctx.strokeStyle = 'rgba(0,0,0,0.25)';
      ctx.lineWidth = 0.8;
      for (var fl = 1; fl < 4; fl++) {
        ctx.beginPath();
        ctx.moveTo(x - s * 0.5, y - s * 1.5 + fl * s * 0.45);
        ctx.lineTo(x + s * 0.5, y - s * 1.5 + fl * s * 0.45);
        ctx.stroke();
      }
      var wColor = o.lit ? '#ffeb3b' : 'rgba(150,200,255,0.75)';
      ctx.shadowColor = o.lit ? '#ffeb3b' : 'transparent';
      ctx.shadowBlur = o.lit ? 6 : 0;
      for (var wx = 0; wx < 3; wx++) {
        for (var wy = 0; wy < 4; wy++) {
          if (o.lit && ((Math.sin(o.windowPhase + wx * 3 + wy) + 1) / 2) < 0.35) continue;
          ctx.fillStyle = wColor;
          ctx.fillRect(x - s * 0.38 + wx * s * 0.3, y - s * 1.4 + wy * s * 0.45,
                       s * 0.18, s * 0.25);
          ctx.strokeStyle = 'rgba(0,0,0,0.3)';
          ctx.lineWidth = 0.5;
          ctx.strokeRect(x - s * 0.38 + wx * s * 0.3, y - s * 1.4 + wy * s * 0.45,
                         s * 0.18, s * 0.25);
        }
      }
      ctx.shadowBlur = 0;
      ctx.fillStyle = 'rgba(0,0,0,0.4)';
      ctx.fillRect(x - s * 0.55, y - s * 1.6, s * 1.1, s * 0.12);
      ctx.fillStyle = 'rgba(0,0,0,0.6)';
      ctx.fillRect(x - s * 0.12, y + s * 0.15, s * 0.24, s * 0.15);
      ctx.fillStyle = '#ffd700';
      ctx.fillRect(x + s * 0.05, y + s * 0.22, s * 0.03, s * 0.03);
      if (o.hasTree) {
        ctx.fillStyle = '#2e7d32';
        ctx.beginPath(); ctx.arc(x + s * 0.65, y + s * 0.15, s * 0.2, 0, Math.PI * 2); ctx.fill();
        ctx.fillStyle = '#5d4037';
        ctx.fillRect(x + s * 0.62, y + s * 0.25, s * 0.06, s * 0.15);
      }
    } else if (o.type === 'pine') {
      ctx.fillStyle = 'rgba(0,0,0,0.25)';
      ctx.beginPath(); ctx.ellipse(x, y + s * 0.45, s * 0.5, s * 0.15, 0, 0, Math.PI * 2); ctx.fill();
      ctx.fillStyle = '#3e2723';
      ctx.fillRect(x - s * 0.07, y, s * 0.14, s * 0.4);
      ctx.fillStyle = o.color;
      for (var p = 0; p < 3; p++) {
        var py = y - s * 0.1 - p * s * 0.35;
        var pw = s * (1 - p * 0.2);
        ctx.beginPath();
        ctx.moveTo(x, py - s * 0.55);
        ctx.lineTo(x + pw * 0.5, py);
        ctx.lineTo(x - pw * 0.5, py);
        ctx.closePath();
        ctx.fill();
        ctx.strokeStyle = 'rgba(0,0,0,0.2)';
        ctx.lineWidth = 1;
        ctx.stroke();
      }
      ctx.fillStyle = '#ffffff';
      ctx.beginPath();
      ctx.moveTo(x, y - s * 1.3);
      ctx.lineTo(x + s * 0.18, y - s * 1.02);
      ctx.lineTo(x - s * 0.18, y - s * 1.02);
      ctx.closePath();
      ctx.fill();
    }
    ctx.restore();
  }
}

