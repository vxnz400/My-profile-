function renderRightPanel() {
  if (rightPanelMode === 'current') {
    rightPanelTitle.innerHTML = '🏁 ' + t('currentRound') + ' <span class="live-dot"></span>';
    renderParticipantsList(roundData.participants || [], 'current');
  } else if (rightPanelMode === 'previous') {
    rightPanelTitle.textContent = '📜 ' + t('previousRound');
    if (previousRoundCache) renderParticipantsList(previousRoundCache.participants || [], 'prev');
    else { leaderboardList.innerHTML = '<div class="lb-empty">' + t('loading') + '</div>'; fetchPrevForPanel(); }
  } else if (rightPanelMode === 'global') {
    rightPanelTitle.textContent = '🌍 ' + t('global');
    fetchGlobalLB();
  }
}
function renderParticipantsList(parts, mode) {
  if (!parts.length) {
    leaderboardList.innerHTML = '<div class="lb-empty">' + (mode === 'current' ? t('noPlayers') : t('loading')) + '</div>';
    return;
  }
  var avM = {};
  if (currentUser) avM[currentUser.username] = currentUser.avatar;
  var h = '';
  var m = ['🥇', '🥈', '🥉'];
  for (var i = 0; i < parts.length; i++) {
    var e = parts[i];
    var me = currentUser && currentUser.username === e.username;
    var rk = i < 3 ? 'rank-' + (i+1) : '';
    var rt = i < 3 ? m[i] : (i + 1);
    var av = avM[e.username] || '';
    var liveClass = (mode === 'current' && gameActive && me) ? ' playing' : '';
    h += '<div class="lb-item ' + rk + (me ? ' is-me' : '') + liveClass + '">';
    h += '<div class="lb-rank">' + rt + '</div>';
    h += '<div class="lb-avatar" style="' + avStyle(e.username, av) + '">' + avHtml(e.username, av) + '</div>';
    h += '<div class="lb-info"><div class="lb-name">' + esc(e.username) + '</div>';
    h += '<div class="lb-score">⭐ ' + (e.score || 0) + (e.prize > 0 ? ' | +' + e.prize : '') + '</div>';
    h += '</div></div>';
  }
  leaderboardList.innerHTML = h;
}
function fetchPrevForPanel() {
  callAPI('previousRound', {})
  .then(function(r) {
    if (r.success) {
      previousRoundCache = r;
      if (rightPanelMode === 'previous') renderParticipantsList(r.participants || [], 'prev');
    }
  })
  .catch(function() { if (rightPanelMode === 'previous') leaderboardList.innerHTML = '<div class="lb-empty">⚠️</div>'; });
}
function fetchGlobalLB() {
  leaderboardList.innerHTML = '<div class="lb-empty">' + t('loading') + '</div>';
  callAPI('globalLB', { limit: 100, sortBy: 'score' })
  .then(function(r) {
    if (r.success && r.list) {
      var h = '';
      var m = ['🥇', '🥈', '🥉'];
      for (var i = 0; i < r.list.length; i++) {
        var e = r.list[i];
